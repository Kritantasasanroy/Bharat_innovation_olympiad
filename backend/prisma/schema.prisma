generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String?
  firstName        String
  lastName         String
  role             Role              @default(STUDENT)
  classBand        Int?
  schoolId         String?
  /// Contact number in E.164 (`+91XXXXXXXXXX`). Editable by the account holder
  /// from their profile page (students) — schools and partners keep theirs on
  /// their request rows. Unique because it doubles as a login identifier for
  /// phone-OTP sign-in, which resolves an account by this column alone.
  phone            String?           @unique
  /// Student-supplied phone number stored at registration even if the OTP was
  /// not completed. NOT unique and NOT a login identifier — it is only used for
  /// WhatsApp notifications when the verified `phone` is absent. Normalised to
  /// E.164 on write so the WhatsApp gateway can use it without conversion.
  phoneRaw         String?
  /// The student's olympiad roll number, e.g. `BIO26-G8-00123` — season year,
  /// grade, then a per-(year, grade) sequence allocated from `Sequence`. Issued
  /// once, at registration, and never reissued: it is printed on the admit card
  /// and quoted in every support conversation, so it must not change if the
  /// student later moves grade. Nullable only so pre-existing rows stay valid
  /// until `scripts/backfill-roll-numbers.ts` has run.
  rollNumber       String?           @unique
  /// Class section as the school writes it — "A", "B2", "Rose". Free text
  /// because Indian schools name sections inconsistently and a fixed A–H list
  /// would lock real students out. Only meaningful alongside `schoolId`, which
  /// is what school admins and teachers group by.
  section          String?
  /// Terms & conditions acceptance captured during registration. Versioned so a
  /// later revision can be re-consented without losing the original record.
  termsAcceptedAt  DateTime?
  termsVersion     String?
  faceEmbedding    Bytes?
  /// The still captured alongside the enrollment descriptor, printed on the
  /// certificate. Set only by `ProctorService.enrollFace` — never editable by
  /// the student directly, unlike `profileImageUrl`, since a self-service photo
  /// would defeat the point of a certificate photo being the one taken at
  /// identity enrollment.
  facePhotoUrl     String?
  profileImageUrl  String?
  isActive         Boolean           @default(true)
  /// Partner campaign referral code the student arrived with (`?ref=CODE`).
  /// Captured at registration; replayed at payment time to credit the paid
  /// conversion to the referring partner's campaign (PRD-046 attribution).
  referralCode     String?
  /// Set when a school coordinator adds this student to their roster. The
  /// student has no account yet — they claim it by registering with this email.
  invitedAt        DateTime?
  /// Set the first time the student completes registration (`/auth/sync`).
  /// `invitedAt` without `activatedAt` is exactly the "invited, not yet signed
  /// up" state the school dashboard reports.
  activatedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attempts         Attempt[]
  refreshTokens    RefreshToken[]
  school           School?           @relation(fields: [schoolId], references: [id])
  bookings         Booking[]
  payments         Payment[]
  accessPass       AccessPass?
  certificates     Certificate[]
  grievances       Grievance[]
  refundRequests   RefundRequest[]
  consents         Consent[]
  trialCompletions TrialCompletion[]
  guardianProfile  GuardianProfile?
  trainingRecords  TrainingRecord[]
  whatsappMessages WhatsAppMessage[]

  @@index([email])
  @@index([schoolId])
  @@index([role])
  @@index([rollNumber])
}

/// Registration "part 2" — the details a parent or guardian fills in, and the
/// parental consent that makes a minor's participation lawful.
///
/// Held in its own table rather than as more columns on `User` for two reasons:
/// it is filled in at a different moment by a different person, and the consent
/// timestamps here are the legal record under the DPDP Act's rules on
/// processing children's data. `AttemptService.startAttempt` refuses to open a
/// real exam until a row exists with both consents given.
///
/// Distinct from `Consent`, which records the *student's* exam-time permissions
/// (media capture, monitoring). Both are kept; neither replaces the other.
model GuardianProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardianFirstName String
  guardianLastName  String
  /// Mother / Father / Legal guardian / Other — free text so an unusual family
  /// arrangement is never unrepresentable.
  relationship      String
  guardianEmail     String
  /// E.164, same convention as `User.phone`. Deliberately NOT unique: siblings
  /// registering separately legitimately share a parent's number.
  guardianPhone     String
  // ── Demographics (optional; used for cohort reporting, never for gating) ──
  studentDob        DateTime?
  gender            String?
  city              String?
  state             String?
  // ── Student ID Document (School ID / Aadhaar / Passport) ──
  idDocumentType    String?
  /// Front of the card. Nullable only because rows created before both sides
  /// were collected still exist; new submissions require it.
  idDocumentUrl     String?
  /// Back of the card. Required on new submissions for the same reason the
  /// front is: a school ID's back carries the class, section and the school's
  /// stamp, and an Aadhaar's carries the address — which is most of what makes
  /// the document worth checking at all.
  idDocumentBackUrl String?
  /// Explicit, separately-ticked consents. Both must be set for the row to be
  /// accepted — `GuardianService` rejects a partial submission rather than
  /// storing half a consent.
  ///
  /// `parentalConsentAt` is the moment the parent accepted: it is the legal
  /// record, and it is deliberately NOT rewritten when they later edit a phone
  /// number. Only a change to the consent wording (`consentVersion`) moves it.
  parentalConsentAt DateTime
  dataConsentAt     DateTime
  consentVersion    String
  /// When the confirmation email to the parent actually left the building.
  ///
  /// Stamped only on a successful send, so null genuinely means "the parent was
  /// never told", not "we tried". That distinction is the whole reason this is
  /// stored rather than inferred from `createdAt` — the mail goes out on a
  /// best-effort path that deliberately never fails the consent submission, so
  /// a consent record can legitimately exist with no mail behind it.
  approvalEmailSentAt DateTime?
  ipAddress         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

/// A named, monotonically increasing counter.
///
/// Exists so roll numbers can be allocated without a race: `getNextSequence`
/// bumps the row inside a transaction and returns the value it claimed, so two
/// simultaneous registrations can never be handed the same number. Counting
/// existing `User` rows instead would hand both requests the same count.
model Sequence {
  key       String   @id
  next      Int      @default(1)
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

/// The school directory. Every row is a school students can pick during
/// registration. A row arrives one of two ways:
///
///  - **Onboarded** — an approved `SchoolRequest`, so it has a coordinator and
///    portal access. `onboardedAt` is set.
///  - **Student-added** — a student could not find their school and added it by
///    name + pincode. No coordinator, no portal access, `onboardedAt` is null.
///
/// `nameKey` is the normalised name (see `schoolNameKey`); together with
/// `pincode` it is the duplicate key, so the same school cannot be added twice
/// under punctuation or casing variants.
model School {
  id              String                 @id @default(uuid())
  name            String
  nameKey         String
  code            String                 @unique
  city            String
  state           String
  pincode         String
  board           String?
  udiseCode       String?
  /// The admin-api `Partner.id` this school belongs to. Set when a partner
  /// onboards the school (or when staff reassign it). A school with no partner
  /// falls back to the house partner (`DEFAULT_PARTNER_ID`) at read time, so the
  /// school portal always has a partner to show — see `PartnerDirectoryService`.
  partnerId       String?
  onboardedAt     DateTime?
  createdAt       DateTime               @default(now())
  users           User[]
  slotAssignments SchoolSlotAssignment[]
  accessRequest   SchoolRequest?

  @@unique([nameKey, pincode])
  @@index([code])
  @@index([pincode])
  @@index([partnerId])
}

model Exam {
  id               String         @id @default(uuid())
  title            String
  description      String?
  classBands       Int[]
  totalMarks       Int
  durationMinutes  Int
  isPublished      Boolean        @default(false)
  isResultReleased Boolean        @default(false)
  feeAmount        Int?
  easyPct          Int            @default(30)
  mediumPct        Int            @default(50)
  hardPct          Int            @default(20)
  /// Retired from the catalogue without being destroyed. Hidden from the student
  /// list and from the admin default view, but every attempt, booking, payment
  /// and certificate that points at it stays intact and auditable. This is how
  /// exams are "scrapped" — deleting them would cascade away real student results.
  isArchived       Boolean        @default(false)
  /// A rehearsal paper. Runs the full proctored exam environment but is never
  /// scored, ranked or listed as a real exam; students may retake it freely.
  isTrial          Boolean        @default(false)
  /// When true, a student must complete the trial exam before this exam will
  /// start. Enforced server-side in AttemptService.startAttempt.
  requiresTrial    Boolean        @default(true)
  /// When false, the exam may be sat at any point inside its instance window
  /// without booking a slot — the slot gate is skipped entirely even if slots
  /// are configured.
  ///
  /// Exists for the beta, where forcing every tester into a numbered sitting got
  /// in the way of the thing actually being tested. Defaults to true, so a real
  /// olympiad still runs to a timetable; existing slots and bookings are left
  /// untouched, so flipping this back restores the schedule exactly as it was.
  requiresSlot     Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  instances        ExamInstance[]
  sections         ExamSection[]

  @@index([isPublished])
  @@index([isArchived])
  @@index([isTrial])
}

model ExamSection {
  id                String            @id @default(uuid())
  examId            String
  title             String
  sortOrder         Int
  questionsToAssign Int               @default(0) // 0 = assign all from pool; N = pick N per student
  exam              Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionQuestions  SectionQuestion[]

  @@index([examId])
}

model Question {
  id            String       @id @default(uuid())
  type          QuestionType
  difficulty    Difficulty
  text          String
  options       Json?
  correctAnswer String?
  marks         Int          @default(1)
  negativeMarks Float        @default(0)
  timeLimitSecs Int?
  mediaUrl      String? // legacy single-media slot (still rendered)
  mediaType     MediaType? // IMAGE | VIDEO | AUDIO | DIAGRAM
  /// A question can carry a picture **and** a video at once, so these are
  /// separate columns rather than another `mediaUrl`/`mediaType` pair. Both are
  /// public object-storage URLs (see `common/services/object-storage.service.ts`).
  imageUrl      String?
  videoUrl      String?
  tags          String[]
  explanation   String?
  createdAt     DateTime     @default(now())

  // ── Innovation Olympiad question-database format (v1.0, 29 approved fields) ──
  // The authoring workbooks carry far more per question than an MCQ needs: the
  // five-pillar taxonomy the exam is *built* from, the competency being probed,
  // and the provenance of any illustration. Held as real columns rather than
  // inside `metadata` because admin filters and the section builder read them,
  // and JSON path filters are awkward in Prisma. All nullable so the legacy
  // 9-column importer and every existing row keep working untouched.
  //
  /// "Question ID" from the workbook, e.g. `EM-OS-08-001`. Indexed, deliberately
  /// NOT unique: the supplied trial workbook genuinely reuses one id, and a
  /// unique constraint would fail the whole import over authoring noise.
  externalId         String?
  grade              Int?
  /// The pillar this question belongs to — `EM`/`PSI`/`ETDR`/`FRG`/`FRD`. This
  /// is what becomes an ExamSection, and what the student sees as the section
  /// heading while attempting the paper.
  partCode           String?
  partName           String?
  /// The finer topic grouping within a pillar. Shown as a per-question sub-label.
  sectionCode        String?
  sectionName        String?
  topic              String?
  learningObjective  String?
  questionCategory   String?
  bloomLevel         String?
  competency         String?
  questionFormat     String?
  /// Shown to the student in the post-exam review, alongside `explanation`.
  futureReadyInsight String?
  /// The workbook's `Image Filename`, used to match this question to an image in
  /// the gallery when the row carries no direct link.
  imageFilename      String?
  /// The original Google Drive URL, kept for provenance after the image has been
  /// mirrored into object storage. `imageUrl` is what actually gets rendered.
  imageSourceUrl     String?
  /// Authoring-only leftovers (Image Description, Canva Prompt, Reviewer
  /// Comments, Version). Never sent to students.
  metadata           Json?

  attemptItems AttemptItem[]
  sectionLinks SectionQuestion[]

  @@index([type])
  @@index([difficulty])
  @@index([externalId])
  @@index([partCode])
  @@index([sectionCode])
}

/// The admin media gallery: every picture/video an admin has uploaded for
/// question authoring, independent of any one question. A question's
/// `imageUrl`/`videoUrl` just stores the `url` here — there is no FK, because
/// the same asset can be reused across many questions and outlives any one of
/// them. `publicId` is what a delete needs at the provider (Cloudinary
/// public_id, or the S3 object key) — the `url` alone isn't enough to remove it.
model MediaAsset {
  id        String         @id @default(uuid())
  kind      MediaAssetKind
  provider  String
  url       String
  publicId  String
  filename  String?
  bytes     Int?
  createdAt DateTime       @default(now())

  @@index([kind])
}

enum MediaAssetKind {
  IMAGE
  VIDEO
}

model SectionQuestion {
  id         String      @id @default(uuid())
  sectionId  String
  questionId String
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  section    ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, questionId])
  @@index([sectionId, sortOrder])
  @@index([questionId])
}

model ExamInstance {
  id                          String                 @id @default(uuid())
  examId                      String
  startsAt                    DateTime
  endsAt                      DateTime
  requireSeb                  Boolean                @default(false)
  browserExamKey              String?
  configKey                   String?
  quitUrl                     String?
  maxAttempts                 Int                    @default(1)
  /// Result-release gating (ADMIN-20). Results cannot be released until a
  /// normalization run has completed; releasing is an audited human decision.
  resultsNormalizedAt         DateTime?
  /// Set the first time results are released to *any* audience. Kept as the
  /// "has this instance been released at all" flag the certificate and legacy
  /// student gates already read.
  resultsReleasedAt           DateTime?
  resultsReleasedBy           String?
  /// Per-audience release (ADMIN-19 extension). Admin releases to students,
  /// schools and partners **independently** — a school can be given results to
  /// review before students see them, and a partner may never see them at all.
  /// Null = that audience cannot see results for this instance.
  resultsReleasedToStudentsAt DateTime?
  resultsReleasedToSchoolsAt  DateTime?
  resultsReleasedToPartnersAt DateTime?
  /// The second, later gate on top of `resultsReleasedToStudentsAt`.
  ///
  /// Releasing to students publishes a score they are told is **provisional** —
  /// it can still move if a proctoring review disqualifies attempts or a
  /// grievance is upheld, both of which change the ranking. Publishing the final
  /// report is the separate, audited decision that says the season is settled:
  /// only then do final score, rank, percentile, section analysis and the answer
  /// key become visible. Kept as two columns rather than one because an admin may
  /// legitimately want the analysis out before the key.
  finalResultsReleasedAt      DateTime?
  answerKeyReleasedAt         DateTime?
  finalReleasedBy             String?
  createdAt                   DateTime               @default(now())
  attempts                    Attempt[]
  slots                       ExamSlot[]
  exam                        Exam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  slotAssignments             SchoolSlotAssignment[]
  certificates                Certificate[]
  trialCompletions            TrialCompletion[]

  @@index([examId])
  @@index([startsAt, endsAt])
}

/// Proof that a student sat the rehearsal paper before this exam instance.
///
/// Recorded when the trial exam is submitted, and checked in
/// `AttemptService.startAttempt`. It lives in its own table rather than as a
/// flag on Attempt because it has to exist *before* any Attempt for the real
/// exam does — it is the precondition for creating one.
model TrialCompletion {
  id             String       @id @default(uuid())
  userId         String
  /// The *real* exam instance this trial run unlocks.
  examInstanceId String
  completedAt    DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examInstance   ExamInstance @relation(fields: [examInstanceId], references: [id], onDelete: Cascade)

  @@unique([userId, examInstanceId])
  @@index([examInstanceId])
}

model Attempt {
  id                String         @id @default(uuid())
  userId            String
  examInstanceId    String
  status            AttemptStatus  @default(NOT_STARTED)
  startedAt         DateTime?
  submittedAt       DateTime?
  totalScore        Float?
  maxScore          Float?
  /// Fair-score processing (ADMIN-19). Written by the normalization run, never
  /// by scoring. Null until the exam instance has been normalized.
  normalizedScore   Float?
  /// Textbook percentile rank ((L + 0.5E)/N * 100) over normalized scores.
  percentile        Float?
  /// Competition ranking (1 + count of strictly-better attempts); ties share a rank.
  rank              Int?
  ipAddress         String?
  deviceFingerprint String?
  riskScore         Float?         @default(0)
  // ── Post-exam human proctoring review ────────────────────────────────────
  // The doc's rule: "A human proctor reviews serious cases … confirm cheating
  // and prepares logs, evidences and leading to disqualification." Risk score
  // alone never disqualifies anyone — a flaky webcam scores like a cheat — so a
  // reviewer's verdict is recorded separately from the signal that flagged it.
  /// PENDING once the attempt lands above the review threshold; CLEARED or
  /// DISQUALIFIED once a human has decided. NOT_REQUIRED for the vast majority
  /// that never trip the threshold.
  reviewStatus      ReviewStatus   @default(NOT_REQUIRED)
  reviewedBy        String?
  reviewedAt        DateTime?
  /// The reviewer's written justification. Mandatory for both verdicts — a
  /// disqualification with no stated reason cannot be defended in a grievance.
  reviewNotes       String?
  createdAt         DateTime       @default(now())
  examInstance      ExamInstance   @relation(fields: [examInstanceId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             AttemptItem[]
  proctorEvents     ProctorEvent[]
  certificate       Certificate?
  grievances        Grievance[]

  @@unique([userId, examInstanceId])
  @@index([userId])
  @@index([examInstanceId])
  @@index([status])
  @@index([reviewStatus])
}

model AttemptItem {
  id         String    @id @default(uuid())
  attemptId  String
  questionId String
  sortOrder  Int       @default(0)
  answer     Json?
  isCorrect  Boolean?
  score      Float?
  answeredAt DateTime?
  attempt    Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId, sortOrder])
}

model ProctorEvent {
  id        String           @id @default(uuid())
  attemptId String
  type      ProctorEventType
  severity  Int              @default(1)
  details   Json?
  timestamp DateTime         @default(now())
  attempt   Attempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([type])
}

/// A training module a student says they attended.
///
/// Self-declared, and deliberately so: the sessions are run by schools and
/// partners in rooms we have no system in, so the only party who can report
/// attendance at the moment it happens is the student. `attendedAt` is when they
/// ticked it, not when the session ran — it is an audit trail for the claim, not
/// a record of the event.
///
/// One row per (student, module). A module is identified by a stable slug rather
/// than a foreign key to a `TrainingModule` table: the six modules are the five
/// olympiad pillars plus the orientation session, they change once a season at
/// most, and a table would add a join and a seeding step to a fixed list.
model TrainingRecord {
  id         String   @id @default(uuid())
  userId     String
  /// Stable slug, e.g. `entrepreneurship-mindset`. See `TRAINING_MODULES`.
  moduleKey  String
  attendedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
  @@index([userId])
  @@index([moduleKey])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum Role {
  STUDENT
  PARENT
  ADMIN
  SUPER_ADMIN
  PARTNER
  SCHOOL
}

enum PartnerRequestStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

/// Backend-owned partner credential + access-review record. The legacy backend
/// is the only JWT signer, so it owns partner login (email + password). The
/// admin-api partner ENGINE (funnel/campaigns/payouts, Drizzle tables) stays
/// separate and is reached over HTTP; `partnerId` is the admin-api Partner.id
/// and is used as the partner JWT `sub` so `sub === partnerId` everywhere.
model PartnerRequest {
  id             String               @id @default(uuid())
  orgName        String
  contactPerson  String
  email          String               @unique
  phone          String
  passwordHash   String
  status         PartnerRequestStatus @default(PENDING)
  /// Null until the contact proves control of the application email.
  emailVerifiedAt DateTime?
  /// Digest of the current email-verification token; the raw token is never persisted.
  emailVerificationTokenHash String? @unique
  emailVerificationTokenExpiresAt DateTime?
  emailVerificationSentAt DateTime?
  emailVerificationTokenUsedAt DateTime?
  partnerId      String? // admin-api Partner.id (also the JWT sub once issued)
  applicationId  String? // admin-api PartnerApplication.id
  decisionReason String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  /// SHA-256 of the access token issued on approval. Unique, so one token
  /// authenticates exactly one partner. Null until approved.
  accessTokenHash   String?   @unique
  /// The same token sealed with AES-256-GCM, opened only when an authenticated
  /// admin re-renders the handover card. See `common/access-token.ts`.
  accessTokenSealed String?
  tokenIssuedAt     DateTime?
  tokenLastUsedAt   DateTime?

  @@index([status])
}

enum SchoolRequestStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

/// A school's request to join the platform (PRD-047), and the credential it is
/// granted on approval. Approval provisions the `School` row and a coordinator
/// `User` (role `SCHOOL`), then issues a single access token; `schoolId` and
/// `coordinatorUserId` are null until then.
///
/// The token itself lives only as a digest (`accessTokenHash`, unique) plus a
/// sealed copy for the admin handover card — never as plaintext.
model SchoolRequest {
  id               String              @id @default(uuid())
  schoolName       String
  board            String
  udiseCode        String?
  pincode          String
  city             String
  state            String
  coordinatorName  String
  coordinatorEmail String              @unique
  coordinatorPhone String
  status           SchoolRequestStatus @default(PENDING)
  /// Set only for a self-applied school (the email-verify-first flow issues an
  /// activation ticket instead of a password). Null for a partner-submitted
  /// school, which has no email/password login of its own until the coordinator
  /// signs in with the access token issued on approval.
  passwordHash String?
  /// Null until the coordinator proves control of the application email.
  emailVerifiedAt DateTime?
  /// Digest of the current email-verification token; the raw token is never persisted.
  emailVerificationTokenHash String? @unique
  emailVerificationTokenExpiresAt DateTime?
  emailVerificationSentAt DateTime?
  emailVerificationTokenUsedAt DateTime?

  /// The admin-api `Partner.id` that onboarded this school, when a partner
  /// submitted the request on the school's behalf rather than the school
  /// self-applying. Staff see the attribution on the review queue.
  submittedByPartnerId String?

  /// The campaign referral code the school arrived on (`/activate?ref=CODE`),
  /// when it self-applied via a partner's onboarding link. Resolves to
  /// `submittedByPartnerId` at apply time; kept so staff see which campaign drove it.
  submittedViaReferralCode String?

  accessTokenHash   String?   @unique
  accessTokenSealed String?
  tokenIssuedAt     DateTime?
  tokenLastUsedAt   DateTime?

  schoolId          String? @unique
  school            School? @relation(fields: [schoolId], references: [id])
  coordinatorUserId String? @unique

  decisionReason String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

enum PreActivationKind {
  SCHOOL
  PARTNER
}

/// The email-verify-first step of self-service onboarding: a coordinator or
/// partner contact confirms their address *before* filling in the rest of the
/// application. Deliberately a standalone table rather than a draft row on
/// `SchoolRequest`/`PartnerRequest` — those tables are the staff review queue,
/// and a half-finished, not-yet-submitted application must never appear there.
///
/// Confirming a token here does not persist a session or a ticket: `apply()`
/// is authorized by a short-lived, self-verifying `verificationTicket` minted
/// at confirm time (see `common/activation-ticket.ts`) and never written to
/// the database, so a row here only ever tracks the emailing step itself.
model PreActivationVerification {
  id   String            @id @default(uuid())
  kind PreActivationKind
  email String

  verifiedAt DateTime?

  /// Digest of the current verification token; the raw token is never persisted.
  tokenHash      String    @unique
  tokenExpiresAt DateTime
  tokenSentAt    DateTime
  tokenUsedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// At most one live verification per address per flow — a fresh "start" call
  /// overwrites it rather than accumulating rows.
  @@unique([kind, email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — results integrity chain, human decision loops, and consent.
// ─────────────────────────────────────────────────────────────────────────────

enum GrievanceType {
  GRIEVANCE
  REATTEMPT
}

enum GrievanceStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  ISSUED
}

/// A certificate issued to a student for a submitted attempt on a RELEASED
/// exam instance. `certificateNumber` is the public, human-shareable id used by
/// the unauthenticated verification endpoint. Revocation is soft (anti-fraud).
model Certificate {
  id                String       @id @default(uuid())
  certificateNumber String       @unique
  attemptId         String       @unique
  attempt           Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examInstanceId    String
  examInstance      ExamInstance @relation(fields: [examInstanceId], references: [id], onDelete: Cascade)
  score             Float
  maxScore          Float
  percentile        Float?
  rank              Int?
  issuedAt          DateTime     @default(now())
  revokedAt         DateTime?
  revokeReason      String?

  @@index([userId])
  @@index([examInstanceId])
}

/// A student-raised complaint or re-attempt request; decided by staff with a
/// mandatory reason. Approving a REATTEMPT grants the student another attempt.
model Grievance {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptId   String?
  attempt     Attempt?        @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  type        GrievanceType   @default(GRIEVANCE)
  subject     String
  description String
  status      GrievanceStatus @default(OPEN)
  resolution  String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

/// A student-requested refund on a PAID payment. Eligibility is evaluated
/// automatically at request time (before the cutoff, and not once a slot
/// booking is CONFIRMED) and re-checked on approval.
model RefundRequest {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId       String       @unique
  payment         Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reason          String
  status          RefundStatus @default(REQUESTED)
  /// Snapshot of the automatic eligibility check at request time.
  eligible        Boolean
  eligibilityNote String?
  decisionReason  String?
  decidedBy       String?
  decidedAt       DateTime?
  refundedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([status])
}

/// Explicit, permanently stored consent (Student §6, DPDP). Versioned so a
/// policy change can require re-consent without losing the historical record.
model Consent {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version        String
  dataProcessing Boolean
  mediaCapture   Boolean
  proctoring     Boolean
  acceptedAt     DateTime @default(now())
  ipAddress      String?

  @@unique([userId, version])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Partner Attribution, Commission & Payout Engine (PRD-046).
//
// These tables are READ AND WRITTEN BY `services/admin-api` via Drizzle, not by
// this backend. They are declared here ONLY so Prisma knows they exist:
// `prisma db push` reconciles the database to this schema and DROPS any table
// it does not know about — and the production backend's start command runs
// `prisma db push --accept-data-loss`. Without these models, every backend
// deploy would silently wipe the partner engine.
//
// Keep in exact sync with
// `services/admin-api/src/adapters/out/persistence/schema/schema.ts`.
// ─────────────────────────────────────────────────────────────────────────────

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum PartnerApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum CampaignStatus {
  ACTIVE
  DEACTIVATED
}

enum AttributionStatus {
  OPEN
  CREDITED
}

enum AttributionRule {
  LINK_FIRST_TOUCH
  COUPON_ONLY
  LINK_ONLY
}

enum CommissionStatementStatus {
  ISSUED
}

enum PayoutStatus {
  PENDING
  SIGNED_OFF
  RELEASED
}

model Partner {
  id                String        @id
  orgName           String
  contactPerson     String
  email             String
  phone             String
  commissionRatePct Int
  status            PartnerStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @db.Timestamp(3)
}

model PartnerApplication {
  id             String                   @id
  partnerId      String
  orgName        String
  contactPerson  String
  email          String
  phone          String
  status         PartnerApplicationStatus @default(SUBMITTED)
  decisionReason String?
  decidedBy      String?
  decidedAt      DateTime?                @db.Timestamp(3)
  createdAt      DateTime                 @default(now()) @db.Timestamp(3)
}

model Campaign {
  id           String         @id
  partnerId    String
  name         String
  linkToken    String         @unique(map: "campaign_link_token_key")
  referralCode String         @unique(map: "campaign_referral_code_key")
  status       CampaignStatus @default(ACTIVE)
  caps         Json?
  createdAt    DateTime       @default(now()) @db.Timestamp(3)
}

model AttributionRecord {
  id             String            @id
  partnerId      String
  campaignId     String
  studentId      String
  registrationId String?
  status         AttributionStatus @default(OPEN)
  ruleApplied    AttributionRule?
  amountPaise    Int?
  convertedAt    DateTime?         @db.Timestamp(3)
  createdAt      DateTime          @default(now()) @db.Timestamp(3)

  @@unique([partnerId, studentId, registrationId], map: "attribution_partner_student_registration_key")
}

model CommissionStatement {
  id            String                    @id
  partnerId     String
  period        String
  version       Int
  lineItemsJson Json
  totalPaise    Int
  status        CommissionStatementStatus @default(ISSUED)
  issuedAt      DateTime                  @default(now()) @db.Timestamp(3)

  @@unique([partnerId, period, version], map: "statement_partner_period_version_key")
}

model PayoutLedgerEntry {
  id                     String       @id
  partnerId              String
  statementId            String
  amountPaise            Int
  status                 PayoutStatus @default(PENDING)
  financeSignOffApprover String?
  financeSignOffAt       DateTime?    @db.Timestamp(3)
  reason                 String?
  createdAt              DateTime     @default(now()) @db.Timestamp(3)
}

model PartnerInstitutionAssignment {
  id            String    @id
  partnerId     String
  institutionId String
  effectiveFrom DateTime  @default(now()) @db.Timestamp(3)
  effectiveTo   DateTime? @db.Timestamp(3)
  assignedBy    String
}

enum QuestionType {
  MCQ
  MULTI_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DIAGRAM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
  /// Set only by a human reviewer via `ProctorService.recordReview`. Deliberately
  /// NOT in `SUBMITTED_STATUSES`, which is the single list normalization, ranking
  /// and certificate issue all read — so a disqualified attempt drops out of all
  /// three at once rather than each one needing its own exclusion.
  DISQUALIFIED
}

/// Where an attempt sits in the post-exam human review process.
enum ReviewStatus {
  NOT_REQUIRED
  PENDING
  CLEARED
  DISQUALIFIED
}

enum ProctorEventType {
  NO_FACE
  MULTIPLE_FACES
  FACE_MISMATCH
  LOOKING_AWAY
  TAB_SWITCH
  /// Focus left the exam window without the tab being hidden — another window,
  /// a notification, a second screen. The player has always posted this; it was
  /// missing from the enum, so every one of those events was rejected by
  /// Postgres and swallowed by the client's best-effort catch.
  WINDOW_BLUR
  EXIT_FULLSCREEN
  SCREEN_CAPTURE
  NETWORK_DISCONNECT
  SEB_VIOLATION
  IP_CHANGE
  /// No mouse, key or touch input for the configured threshold. Severity 1: it
  /// is a signal for the reviewer's timeline, not evidence of anything on its
  /// own — a student reading a long question is idle by this definition.
  INACTIVITY
}

// ── Slot booking & payment models ────────────────────────────────────────────

model ExamSlot {
  id                String                 @id @default(uuid())
  examInstanceId    String
  examInstance      ExamInstance           @relation(fields: [examInstanceId], references: [id], onDelete: Cascade)
  label             String?
  startsAt          DateTime
  endsAt            DateTime
  capacity          Int
  booked            Int                    @default(0)
  createdAt         DateTime               @default(now())
  bookings          Booking[]
  schoolAssignments SchoolSlotAssignment[]

  @@index([examInstanceId])
  @@index([startsAt])
}

// A school's students all land in the same slot for a given exam instance —
// admin-editable per school (see SchoolSlotService); students with no
// assignment for their school keep using the existing manual slot-picker.
model SchoolSlotAssignment {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examInstanceId String
  examInstance   ExamInstance @relation(fields: [examInstanceId], references: [id], onDelete: Cascade)
  slotId         String
  slot           ExamSlot     @relation(fields: [slotId], references: [id])
  assignedBy     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([schoolId, examInstanceId])
  @@index([examInstanceId])
  @@index([slotId])
}

model Booking {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotId    String
  slot      ExamSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  paymentId String?       @unique
  payment   Payment?      @relation(fields: [paymentId], references: [id])
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, slotId])
  @@index([userId])
  @@index([slotId])
  @@index([status])
}

model Payment {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayOrderId   String         @unique
  razorpayPaymentId String?        @unique
  razorpaySignature String?
  amount            Int
  currency          String         @default("INR")
  status            PaymentStatus  @default(CREATED)
  couponId          String?
  coupon            Coupon?        @relation(fields: [couponId], references: [id])
  booking           Booking?
  accessPass        AccessPass?
  refundRequest     RefundRequest?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
}

/// A student's one-off platform fee. Paying once grants access to *every*
/// exam, so this is account-level (`userId` unique) rather than per-slot —
/// unlike `Booking`, which reserves a specific seat. `AttemptService`
/// treats an ACTIVE pass as the authorisation to sit any real exam.
model AccessPass {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The payment that bought this pass. Null only while an order is being
  /// created; set for the lifetime of the pass afterwards.
  paymentId String?          @unique
  payment   Payment?         @relation(fields: [paymentId], references: [id])
  status    AccessPassStatus @default(PENDING)
  /// Amount actually charged, in paise — kept here so a later price change
  /// never rewrites what a student was billed.
  amount    Int
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
}

/// A pending phone sign-in code.
///
/// Issued and verified by this backend rather than Neon Auth: Neon's `send.otp`
/// webhook payload carries no recipient phone number, so it cannot address a
/// WhatsApp message. Email OTP still goes through Neon untouched.
model PhoneOtp {
  id         String    @id @default(uuid())
  /// E.164, normalised by `normalizePhone` so lookups match what was sent.
  phone      String
  /// SHA-256 of the code — a leaked DB row must not hand over a live code.
  codeHash   String
  expiresAt  DateTime
  /// Set once redeemed; a code is single-use.
  consumedAt DateTime?
  /// Wrong guesses so far. Caps brute-forcing a 6-digit code.
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
}

enum AccessPassStatus {
  /// Order created, payment not yet confirmed — grants nothing.
  PENDING
  /// Paid and confirmed — unlocks every exam.
  ACTIVE
  /// Refunded or revoked by an admin — no longer unlocks anything.
  REVOKED
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  discountPct Int
  maxUses     Int
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  payments    Payment[]
  createdAt   DateTime  @default(now())

  @@index([code])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin power — permanent deletion with a preserved audit trail.
// ─────────────────────────────────────────────────────────────────────────────

enum ArchivedEntityType {
  STUDENT
  SCHOOL
  PARTNER
}

/// A tombstone written the instant an admin permanently deletes a student,
/// school, or partner. The operational rows are hard-deleted from their tables
/// (a real Neon delete), but their identifying details — and a full JSON
/// snapshot — are preserved here so a deletion is auditable and the contact is
/// still recoverable on paper. Nothing references this table; it only grows.
model ArchivedEntity {
  id             String             @id @default(uuid())
  entityType     ArchivedEntityType
  originalId     String
  name           String
  email          String?
  phone          String?
  /// The full row(s) as they were at delete time (the deleted record plus any
  /// provisioned rows removed alongside it, e.g. a school's coordinator user).
  snapshot       Json
  reason         String?
  deletedBy      String
  deletedByEmail String?
  deletedAt      DateTime           @default(now())

  @@index([entityType])
  @@index([email])
  @@index([originalId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Support tickets — grievances raised by partners and schools, seen by admin.
// Distinct from the student `Grievance` (which is exam/attempt-bound): a partner
// isn't a User at all, and these are free-form help requests, not re-attempts.
// ─────────────────────────────────────────────────────────────────────────────

enum SupportTicketSource {
  PARTNER
  SCHOOL
}

enum SupportTicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

model SupportTicket {
  id             String              @id @default(uuid())
  source         SupportTicketSource
  /// The raiser's id — a partner's admin-api `Partner.id`, or a school
  /// coordinator's `User.id`. Stored as a plain string (partners have no User row).
  submitterId    String
  submitterName  String
  submitterEmail String
  category       String
  subject        String
  message        String
  status         SupportTicketStatus @default(OPEN)
  response       String?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([source])
  @@index([status])
  @@index([submitterId])
}

enum AnnouncementAudience {
  PARTNER
  SCHOOL
  ALL
}

model Announcement {
  id          String              @id @default(uuid())
  title       String
  body        String
  audience    AnnouncementAudience
  /// Scheduled/visible start time. Posts with a future publishedAt are drafted.
  publishedAt DateTime
  /// Soft-expiry: null means visible indefinitely.
  expiresAt   DateTime?
  active      Boolean             @default(true)
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  /// Narrows a SCHOOL/ALL post to one school. Null means every school in the
  /// audience sees it (the original broadcast-only behaviour). Not a formal
  /// relation — a school can be deleted independently without touching posts.
  targetSchoolId String?

  @@index([audience])
  @@index([active, publishedAt])
  @@index([targetSchoolId])
}

enum WhatsAppStatus {
  /// Claimed by a sender but not yet answered for — a row left here means the
  /// process died mid-send, which is the one case worth being able to see.
  PENDING
  /// WATI accepted it for delivery. Not proof it reached the handset: a number
  /// that never opted in fails downstream, and WATI reports that only by webhook.
  SENT
  FAILED
}

/// Every WhatsApp template message this app sends, and the reason it is allowed
/// to be sent only once.
///
/// ## Why a table rather than a log line
///
/// Two of the four sends fan out over an entire cohort (final results) or run on
/// a timer that fires repeatedly (the day-before reminder). Without a durable
/// record, a restart mid-fan-out re-messages everyone already contacted, and the
/// reminder sweeper re-sends on every tick — thousands of duplicate WhatsApps to
/// school students, which is both a support incident and the fastest way to have
/// the WhatsApp number reported and rate-limited by Meta.
///
/// `dedupeKey` is what makes "once" precise, and it differs per template: the
/// attempt id for a submission or a result, the booking id for a schedule, and
/// the booking id plus the exam's IST date for a reminder (so a rescheduled
/// student is legitimately reminded again about their new date).
///
/// The row is written **before** the send, not after: two workers racing on the
/// same student must have one of them lose on the unique index rather than both
/// discover afterwards that they each sent a message.
model WhatsAppMessage {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The approved template's name, e.g. `bio_submission`. Not an enum: adding a
  /// template must not require a migration, and Meta owns the real list.
  template   String
  /// What "already sent" means for this template — see the model comment.
  dedupeKey  String
  /// E.164, as it was at send time. Kept because a student may change their
  /// number later and "where did this go?" must stay answerable.
  phone      String
  status     WhatsAppStatus @default(PENDING)
  /// WATI's message id — the handle that finds this send in their dashboard.
  providerId String?
  /// The provider's rejection, already redacted. Null on success.
  error      String?
  createdAt  DateTime       @default(now())
  sentAt     DateTime?

  @@unique([template, dedupeKey])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
