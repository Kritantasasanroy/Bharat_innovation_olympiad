# Database
DATABASE_URL=postgresql://olympiad_user:olympiad_dev_pass@localhost:5432/olympiad

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# Redis
REDIS_URL=redis://localhost:6379

# Proctor Service (Meazure Learning / ProctorU bridge)
# The Python proctor-service must be running at this URL
PROCTOR_SERVICE_URL=http://localhost:5000
# Shared secret — must match PROCTOR_API_KEY in proctor-service/.env
PROCTOR_API_KEY=dev-proctor-key

# Frontend
FRONTEND_URL=http://localhost:3000

# App
PORT=4000
APP_URL=https://exam.bharatolympiad.in

# Razorpay (use rzp_test_... keys for development)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── SMS / OTP ────────────────────────────────────────────────────────────────
# 2Factor is the ONLY SMS gateway (it is also the only one offering voice OTP).
# There is no SMS_PROVIDER switch any more — a leftover value is ignored and
# logged as a warning at boot.
#
# ⚠️ If SMS is accepted but no handset ever receives it while VOICE OTP works,
# the account needs KYC / business verification, not a config change.
# See docs/2FACTOR-KYC-SETUP.md for the exact steps.
TWOFACTOR_API_KEY=
# The DLT template name to send OTPs under. The literal value `AUTOGEN` (or a
# blank) means "no template name appended — use the account default template".
# If SMS is accepted (Status: Success) but never arrives, the account default is
# almost certainly not DLT-approved: put the approved template name here instead.
# Check with GET /api/admin/notifications/sms-health.
TWOFACTOR_OTP_TEMPLATE=AUTOGEN
# After each OTP send, ask 2Factor for the carrier's delivery report ~15s later
# and log the verdict. This is the only way to tell an accepted-but-dropped SMS
# from a delivered one. Set to `false` to disable.
TWOFACTOR_VERIFY_DELIVERY=true
# Only used by the admin broadcast SMS (/admin/mail/send), not by OTP.
TWOFACTOR_SENDER_ID=
TWOFACTOR_SMS_TEMPLATE=

# ── Media storage ────────────────────────────────────────────────────────────
# Cloudinary is the default provider when its three keys are present; an
# explicit STORAGE_PROVIDER (`cloudinary` | `s3`) always wins. Render's disk is
# ephemeral, so local-disk storage is not an option.
STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Drive question-image gallery. The folder must be shared
# "Anyone with the link — Viewer".
#
# The API key is OPTIONAL. Without one the folder is listed anonymously from its
# own public folder page; set it to use the Drive API instead, which is also the
# only way to list a folder that is not link-shared.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_GALLERY_FOLDER_ID=17uieaNy6KULjNjJ-47AIcIrEn_QROR52

# AWS S3 (alternative to Cloudinary for question media, proctor snapshots, invoices)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=bio-olympiad-prod

# ── WhatsApp (WATI) ──────────────────────────────────────────────────────────
# Every WhatsApp message this app sends is a Meta-APPROVED template
# (bio_submission, bio_schedule, bio_result, bio_reminder) — free text is not
# possible for a business-initiated message, so nothing here composes prose.
#
# The endpoint carries the WATI tenant id in its path, so it is account-specific
# and must match the token. Find both under WATI → API Docs.
WATI_API_ENDPOINT=https://live-mt-server.wati.io/XXXXXXXX
WATI_ACCESS_TOKEN=
# Master kill switch for a live cohort: `false` stops every WhatsApp send while
# leaving email and SMS untouched. Anything else (or unset) means enabled.
WHATSAPP_ENABLED=true
# The T-1 day `bio_reminder` sweeper, which runs hourly in-process. Set to
# `false` to stop it without disabling the other three messages.
WHATSAPP_REMINDERS_ENABLED=true
# Check what the account can actually send: GET /api/admin/whatsapp/health
