# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
# pnpm's local content-addressable store, created when a machine has no
# established global store path (e.g. a fresh container/CI run) — a cache,
# not something to commit.
.pnpm-store/

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
.next/
# Scoped to each app's own build-output dir (Next.js static export), not a
# bare `out/` — an unanchored `out/` here previously matched every service's
# `core/ports/out/` and `adapters/out/` hexagonal-architecture directories
# too (out-bound ports/adapters), silently keeping them out of git across
# services/exam-api, services/admin-api, and services/portal-api. Verified
# via `git log --all -- services/exam-api/src/adapters/out` (and admin-api's
# equivalent) returning no history at all on this branch.
apps/*/out/
/frontend/out/
/admin-frontend/out/
*.tsbuildinfo

# ── Environment ───────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.*.local

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
*.egg-info/

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker ────────────────────────────────────────────────────
docker-compose.override.yml

# ── Prisma ────────────────────────────────────────────────────
backend/prisma/*.db

# ── ONNX / ML models (large binaries) ────────────────────────
proctor-service/models/*.onnx
*.onnx

# ── Office documents (not source code) ───────────────────────
*.xlsx
*.xls
*.docx
*.doc
*.pptx
*.ppt

# …except the question papers themselves, which are source: they are what
# `backend/scripts/setup-beta-exams.js` imports, and the `.xlsm` papers were
# already tracked. A paper the repo cannot see is an import nobody can re-run.
!Grade_*_Question_*.xlsx
!Trial_Test_*.xlsx

# ── Source / raw image assets ─────────────────────────────────
# Optimised copies live in */public/ — don't commit originals
Bio logo.png
innopreneurs-logo-BJ5i0_1X.png
Lemon-Ideas-Final-Logo.png

# ── Dev-only convenience scripts ──────────────────────────────
start-dev.bat

# ── Temp / scratch files committed by mistake ─────────────────
backend/tmp_check.js
backend/test_api.js
backend/update_types.js
backend/vercel.json
frontend/db.js
frontend/test.js
frontend/prisma/
FULLSCREEN_IMPLEMENTATION.md

# ── Claude Code configuration & cache ────────────────────────
.claude/

# ── Vercel local project config (contains project IDs) ───────
**/.vercel/

# ── Large archives (exceed GitHub 100 MB limit) ──────────────
*.zip
*.tar.gz
*.rar
